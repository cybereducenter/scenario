<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ page_title }}</title>
  <link rel="stylesheet" href="{{ css_href }}">
</head>
<body>
  <div class="moodle-report-wrap" dir="rtl">
    <div class="wrap">

      <!-- Top summary section -->
      <div class="topbar">
        <div>
          <div class="title">{{ title_text }}</div>
          {% if subtitle_text %}
            <div class="sub">{{ subtitle_text }}</div>
          {% endif %}
        </div>

        <!-- Gauge score -->
        <div class="scoreContainer">
          <div class="scoreBox">
            <svg class="gauge" width="118" height="59" viewBox="0 0 118 59" fill="none">
              <path d="M 14 58 A 45 45 0 0 1 104 58"
                    fill="none" stroke="#D3D3DB" stroke-width="24.7552"/>
              <path d="M 14 58 A 45 45 0 0 1 104 58"
                    fill="none" stroke="{{ gauge_color }}"
                    stroke-width="24.7552"
                    pathLength="100"
                    stroke-dasharray="100"
                    stroke-dashoffset="{{ gauge_dashoffset }}" />
            </svg>
            <div class="gauge-text">{{ score_percent }}%</div>
          </div>
          <div class="desc">{{ passed }}/{{ total }} תרחישים עברו</div>
        </div>
      </div>

      <div class="sectionTitle">{{ section_title }}</div>

      <!-- Loop over tests -->
      <div class="tests">
        {% for t in tests %}
          <div class="test">
            <div class="row">

              <!-- Collapsible header -->
              <div class="testMain" data-toggle="details_{{ t.id }}">
                <div class="test-header-row">
                  <div class="badge {{ 'ok' if t.passed else 'fail' }}">
                    {{ '✓ הצלחה' if t.passed else '✗ אי-הצלחה' }}
                  </div>
                  <div class="name">{{ t.name }}</div>
                </div>

                {% if (not t.passed) and t.feedback_text %}
                  <div class="testSummary fail">{{ t.feedback_text }}</div>
                {% endif %}
              </div>

              <button class="chev" data-toggle="details_{{ t.id }}">▾</button>
            </div>

            <!-- Collapsible details -->
            <div class="details" id="details_{{ t.id }}">
              <div class="boxTitle">תיאור הבדיקה</div>
              <div class="hint">{{ t.description }}</div>

              <div class="boxTitle">תוצאות הרצה</div>
              <div class="tableWrap">
                <table class="logTable">
                  <tbody>
                    {% for line in t.lines %}
  <tr class="{% if loop.first %}first-row{% endif %}{% if loop.last %} last-row{% endif %}">
    <td class="cell-log-text" dir="ltr">
      <div class="terminal-line-wrap">
        {% if loop.first %}
          <div class="terminal-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
        {% endif %}
        <pre>{{ line.text }}</pre>
      </div>
    </td>

    <td class="cell-log-anno">
      {% if line.anno %}
        <div class="anno-interactive-wrapper">
          <span class="anno-icon" data-anno="1"><strong>ⓘ</strong></span>
          <span class="tooltip-content"><strong>{{ line.anno_kind }} </strong>{{ line.anno_name }}</span>
        </div>
      {% endif %}
    </td>
  </tr>
{% endfor %}

                  </tbody>
                </table>
              </div>
            </div>

          </div>
        {% endfor %}
      </div>

      <div class="foot">{{ footer_text }}</div>
    </div>
  </div>
  <script>
document.addEventListener('DOMContentLoaded', function() {
  // Accordion: open/close details
  document.querySelectorAll('[data-toggle]').forEach(function(el) {
    el.addEventListener('click', function(e) {
      e.stopPropagation();

      const targetId = el.getAttribute('data-toggle');
      const target = document.getElementById(targetId);
      if (!target) return;

      const isVisible = target.style.display === 'block';
      target.style.display = isVisible ? 'none' : 'block';

      // Rotate chevron if present
      const testRow = el.closest('.test');
      if (testRow) {
        const chev = testRow.querySelector('.chev');
        if (chev) {
          chev.style.transform = isVisible ? 'rotate(0deg)' : 'rotate(180deg)';
        }
      }
    });
  });

  // Tooltip: open/close annotation bubbles
  document.querySelectorAll('.anno-icon').forEach(function(icon) {
    icon.addEventListener('click', function(e) {
      e.stopPropagation();

      const tip = icon.nextElementSibling; // expects .tooltip-content right after .anno-icon
      if (!tip || !tip.classList.contains('tooltip-content')) return;

      const isVisible = tip.classList.contains('visible');

      // Close any other open tooltips
      document.querySelectorAll('.tooltip-content.visible').forEach(function(v) {
        v.classList.remove('visible');
      });

      // Toggle this one
      if (!isVisible) {
        tip.classList.add('visible');
      }
    });
  });

  // Close tooltips when clicking anywhere else
  document.addEventListener('click', function() {
    document.querySelectorAll('.tooltip-content.visible').forEach(function(v) {
      v.classList.remove('visible');
    });
  });
});
</script>
</body>
</html>